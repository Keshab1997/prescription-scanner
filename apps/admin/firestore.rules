rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Whether the caller is the configured admin (Firebase-auth'd email).
    // Mobile app users authenticate with Supabase, NOT Firebase, so their
    // Firestore requests arrive with request.auth == null. Writes from the
    // mobile app must therefore be gated on data shape, not on auth.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'Keshabsarkar2018@gmail.com';
    }

    // Gemini API key pool — admin-only writes.
    // The keys are consumed client-side on the mobile app (it calls Gemini
    // directly), so on-device secrecy is not achievable; we only protect
    // writes (admin-only) and keep reads open for the mobile app.
    match /admin_api_keys/{keyId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Key groups (optional pool segmentation used by ApiKeyManager).
    match /admin_key_groups/{groupId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Batched error logs from the key manager (mobile + admin).
    // Mobile writes arrive unauthenticated (Supabase auth), so writes must be
    // allowed for request.auth == null. Logs are non-sensitive (no keys) and
    // auto-deleted via TTL, so open writes are acceptable. Reads are open to
    // any signed-in admin-console user (the console requires Firebase login).
    match /api_error_logs/{logId} {
      allow read: if request.auth != null;
      allow write: if request.auth == null || isAdmin();
    }

    // All-keys-failed alert written by the mobile app when every key dies.
    match /admin_alerts/{alertId} {
      allow read: if request.auth != null;
      allow write: if request.auth == null || isAdmin();
    }

    // Admin contact record.
    match /admin_contacts/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}
