rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        (
          'admin' in request.auth.token
          && request.auth.token.admin == true
        )
        || (
          request.auth.token.email is string
          && request.auth.token.email.matches(
            '(?i)^keshabsarkar2018@gmail[.]com$'
          )
        )
      );
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isActiveUser() {
      return isVerifiedUser()
        && exists(
          /databases/$(database)/documents/profiles/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/profiles/$(request.auth.uid)
        ).data.status == 'active';
    }

    function validString(value, minLength, maxLength) {
      return value is string
        && value.size() >= minLength
        && value.size() <= maxLength;
    }

    // User profile document ID is always the Firebase UID.
    match /profiles/{uid} {
      allow read: if isAdmin() || isSelf(uid);

      allow create: if isSelf(uid)
        && request.resource.data.keys().hasAll([
          'displayName', 'email', 'role', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'displayName', 'email', 'role', 'status', 'createdAt', 'updatedAt'
        ])
        && validString(request.resource.data.displayName, 1, 80)
        && request.resource.data.email is string
        && request.resource.data.role == 'user'
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // A user can edit only their display name. Role, status, email and
      // creation time remain server/admin-controlled and immutable.
      allow update: if isAdmin() || (
        isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'updatedAt'
        ])
        && validString(request.resource.data.displayName, 1, 80)
        && request.resource.data.updatedAt == request.time
      );

      // A user can delete their own profile as part of account deletion.
      allow delete: if isAdmin() || isSelf(uid);
    }

    match /app_settings/{docId} {
      // Public runtime config (daily limit, AI switch, maintenance mode).
      // Anonymous guests read it too so free scans honour the same switches.
      allow read: if isAdmin() || isActiveUser() || !isSignedIn();
      allow write: if isAdmin();
    }

    // One document per user/day: {uid}-{yyyy-MM-dd}.
    match /daily_usage/{docId} {
      // resource == null covers a missing doc (first scan of the day), so the
      // client can fall back to "0 used" without hitting a rule error.
      allow read: if isAdmin() || (
        isActiveUser()
        && (resource == null || resource.data.user_id == request.auth.uid)
      );

      allow create: if isActiveUser()
        && request.resource.data.keys().hasAll([
          'user_id', 'usage_date', 'request_count', 'successful_count',
          'failed_count', 'updated_at'
        ])
        && request.resource.data.keys().hasOnly([
          'user_id', 'usage_date', 'request_count', 'successful_count',
          'failed_count', 'updated_at'
        ])
        && request.resource.data.user_id == request.auth.uid
        && docId == request.auth.uid + '-' + request.resource.data.usage_date
        && request.resource.data.usage_date is string
        && request.resource.data.request_count == 1
        && request.resource.data.successful_count == 1
        && request.resource.data.failed_count == 0
        && request.resource.data.updated_at == request.time;

      allow update: if isActiveUser()
        && resource.data.user_id == request.auth.uid
        && request.resource.data.user_id == resource.data.user_id
        && request.resource.data.usage_date == resource.data.usage_date
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'request_count', 'successful_count', 'updated_at'
        ])
        && request.resource.data.request_count == resource.data.request_count + 1
        && request.resource.data.successful_count
          == resource.data.successful_count + 1
        && request.resource.data.failed_count == resource.data.failed_count
        && request.resource.data.updated_at == request.time;

      // Users may delete their own usage rows when deleting their account.
      allow delete: if isAdmin() || (
        isActiveUser() && resource.data.user_id == request.auth.uid
      );
    }

    // AI consent is local in the privacy-first app. These rules protect any
    // existing/future server audit records by owner UID.
    match /consent_records/{docId} {
      allow read: if isAdmin() || (
        isActiveUser() && resource.data.user_id == request.auth.uid
      );
      allow create: if isActiveUser()
        && request.resource.data.user_id == request.auth.uid;
      // Users may delete their own consent rows when deleting their account.
      allow update, delete: if isAdmin() || (
        isActiveUser() && resource.data.user_id == request.auth.uid
      );
    }

    match /prescription_feedback/{docId} {
      allow read: if isAdmin() || (
        isActiveUser() && resource.data.user_id == request.auth.uid
      );
      allow create: if isActiveUser()
        && request.resource.data.keys().hasAll([
          'user_id', 'prescription_id', 'category', 'details', 'created_at'
        ])
        && request.resource.data.keys().hasOnly([
          'user_id', 'prescription_id', 'category', 'details', 'created_at'
        ])
        && request.resource.data.user_id == request.auth.uid
        && validString(request.resource.data.prescription_id, 1, 128)
        && request.resource.data.category in [
          'incorrect_name', 'incorrect_details', 'missing_medicine',
          'not_prescription', 'other'
        ]
        && (
          request.resource.data.details == null
          || validString(request.resource.data.details, 1, 1000)
        )
        && request.resource.data.created_at == request.time;
      // Users may delete their own feedback when deleting their account.
      allow update, delete: if isAdmin() || (
        isActiveUser() && resource.data.user_id == request.auth.uid
      );
    }

    match /account_deletion_requests/{uid} {
      allow read: if isAdmin() || isSelf(uid);
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasAll([
          'email', 'requestedAt', 'status'
        ])
        && request.resource.data.keys().hasOnly([
          'email', 'requestedAt', 'status'
        ])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedAt == request.time;
      allow update, delete: if isAdmin();
    }

    // Temporary compatibility for the current direct-Gemini architecture.
    // API keys are not user data; move them behind a backend before production.
    // Anonymous guests may read the pool too so free scans work without an
    // account. NOTE: this makes the key pool readable by anyone who knows the
    // project ID (the client already fetches keys on-device); rotate keys or
    // move behind a backend proxy for production.
    match /admin_api_keys/{keyId} {
      allow read: if isAdmin() || isActiveUser() || !isSignedIn();
      allow write: if isAdmin();
    }

    match /admin_key_groups/{groupId} {
      allow read: if isAdmin() || isActiveUser() || !isSignedIn();
      allow write: if isAdmin();
    }

    match /api_error_logs/{logId} {
      allow read: if isAdmin() || (
        isActiveUser() && resource.data.userId == request.auth.uid
      );
      allow create: if isActiveUser()
        && request.resource.data.keys().hasAll([
          'keyId', 'keyName', 'userId', 'feature', 'errorType',
          'statusCode', 'message', 'retried', 'retrySuccess',
          'timestamp', 'ttlExpireAt'
        ])
        && request.resource.data.keys().hasOnly([
          'keyId', 'keyName', 'userId', 'feature', 'errorType',
          'statusCode', 'message', 'retried', 'retrySuccess',
          'timestamp', 'ttlExpireAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && validString(request.resource.data.keyId, 1, 128)
        && validString(request.resource.data.keyName, 1, 160)
        && validString(request.resource.data.feature, 1, 80)
        && request.resource.data.errorType in [
          'network_error', 'rate_limit', 'auth_error',
          'server_error', 'unknown'
        ]
        && request.resource.data.statusCode is int
        && request.resource.data.statusCode >= 0
        && request.resource.data.statusCode <= 599
        && validString(request.resource.data.message, 1, 500)
        && request.resource.data.retried is bool
        && request.resource.data.retrySuccess is bool
        && request.resource.data.timestamp is timestamp
        && request.resource.data.ttlExpireAt is timestamp;
      allow update: if false;
      // Users may delete their own error log rows during account deletion.
      allow delete: if isAdmin() || (
        isActiveUser() && resource.data.userId == request.auth.uid
      );
    }

    match /admin_audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.admin_uid == request.auth.uid
        && validString(request.resource.data.action, 1, 80)
        && request.resource.data.created_at == request.time;
      allow update, delete: if false;
    }

    match /admin_alerts/{alertId} {
      allow read, write: if isAdmin();
    }

    match /admin_contacts/{docId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
