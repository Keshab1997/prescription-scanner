rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Gemini API key pool — any signed-in user may read/write (admin app).
    // Tighten to a specific admin email once the admin account is confirmed.
    match /admin_api_keys/{keyId} {
      allow read, write: if request.auth != null;
    }

    // Batched error logs from the key manager.
    match /api_error_logs/{logId} {
      allow read, write: if request.auth != null;
    }

    // Admin contact record.
    match /admin_contacts/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
