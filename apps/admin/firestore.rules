rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Gemini API key pool — admin writers/readers only.
    // The mobile app reads keys at runtime; only admins may write.
    match /admin_api_keys/{keyId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.token.email == 'Keshabsarkar2018@gmail.com';
    }

    // Batched error logs from the key manager.
    match /api_error_logs/{logId} {
      allow read: if request.auth != null
                  && request.auth.token.email == 'Keshabsarkar2018@gmail.com';
      allow write: if request.auth != null;
    }

    // Admin contact record.
    match /admin_contacts/{docId} {
      allow read, write: if request.auth != null
                         && request.auth.token.email == 'Keshabsarkar2018@gmail.com';
    }
  }
}
